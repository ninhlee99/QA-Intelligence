{
  "name": "qa-intelligence",
  "version": "0.9.0",
  "private": false,
  "description": "Production-oriented Expert QA MCP server for coding agents",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "bin": {
    "qa-intelligence-mcp": "./dist/src/mcp/stdio-entrypoint.js"
  },
  "files": [
    "dist/src/**/*.js",
    "dist/src/**/*.d.ts",
    "hosts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "build": "npm run clean && tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/tests/**/*.test.js\"",
    "benchmark:qa-qc": "npm run build && node scripts/run-qa-qc-benchmark.mjs",
    "benchmark:browser-workflow": "npm run build && node scripts/run-browser-workflow-benchmark.mjs",
    "benchmark:resilience": "npm run build && node scripts/run-qa-resilience-benchmark.mjs",
    "benchmark:continuous-qa": "npm run build && node scripts/run-continuous-qa-benchmark.mjs",
    "benchmark:deep-testing": "npm run build && node scripts/run-deep-testing-benchmark.mjs",
    "benchmark:qa-lead-mcp": "npm run build && node scripts/run-qa-lead-mcp-benchmark.mjs",
    "readiness:report": "npm run build && node scripts/check-production-readiness.mjs --report-only",
    "readiness:production": "npm run build && node scripts/check-production-readiness.mjs",
    "release-candidate:report": "npm run build && node scripts/check-release-candidate.mjs --report-only",
    "release-candidate:check": "npm run build && node scripts/check-release-candidate.mjs",
    "validate": "npm run typecheck && npm test && npm run validate:distribution && npm run validate:dependencies",
    "validate:schemas": "node tests/validate-json-schemas.mjs",
    "validate:dependencies": "npm audit --audit-level=high",
    "validate:distribution": "node scripts/validate-distribution.mjs",
    "release:check": "npm run validate && npm run readiness:production && npm run release-candidate:check",
    "prepack": "npm run build",
    "mcp:start": "npm run build && node dist/src/mcp/stdio-entrypoint.js",
    "mcp:fixture": "npm run build && node dist/src/mcp/dev-entrypoint.js",
    "mcp:remote:demo": "npm run build && node dist/src/mcp/remote-dev-entrypoint.js"
  },
  "keywords": [
    "mcp",
    "qa",
    "testing",
    "playwright",
    "claude-code",
    "cursor",
    "codex",
    "antigravity"
  ],
  "license": "MIT",
  "dependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fast-json-stable-stringify": "^2.1.0",
    "jose": "6.2.8",
    "js-yaml": "^5.2.3",
    "pg": "8.22.0",
    "playwright": "^1.62.1",
    "simple-git": "^3.36.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "24.13.3",
    "@types/pg": "8.20.4",
    "typescript": "7.0.2"
  }
}
