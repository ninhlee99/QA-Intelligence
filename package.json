{
  "name": "qa-intelligence",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server that acts as an Expert QA Engineer in Claude Code, Cursor, and Codex",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/tests/**/*.test.js\"",
    "validate": "npm run typecheck && npm test && npm run validate:dependencies",
    "validate:schemas": "node tests/validate-json-schemas.mjs",
    "validate:dependencies": "npm audit --audit-level=high",
    "release:check": "npm run validate",
    "mcp:dev": "npm run build && node dist/src/mcp/dev-entrypoint.js",
    "mcp:remote": "npm run build && node dist/src/mcp/remote-dev-entrypoint.js"
  },
  "keywords": [
    "mcp",
    "qa",
    "testing",
    "playwright",
    "claude-code",
    "cursor",
    "codex"
  ],
  "license": "MIT",
  "dependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fast-json-stable-stringify": "^2.1.0",
    "jose": "6.2.8",
    "js-yaml": "^5.2.3",
    "pg": "8.22.0",
    "playwright": "^1.62.1",
    "simple-git": "^3.36.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "24.13.3",
    "@types/pg": "8.20.4",
    "typescript": "7.0.2"
  }
}
