{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qa-intelligence.local/schemas/evaluation-result.schema.json",
  "title": "Evaluation Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "workspace_id", "subject", "suite", "resolved_versions", "trial_results", "critical_invariants", "metrics", "verdict", "recommendation", "evidence", "started_at", "completed_at"],
  "properties": {
    "run_id": {"type": "string"},
    "workspace_id": {"type": "string"},
    "subject": {"type": "object", "required": ["type", "id", "version"], "properties": {"type": {"enum": ["agent", "skill"]}, "id": {"type": "string"}, "version": {"type": "string"}}},
    "suite": {"type": "object", "required": ["id", "version"], "properties": {"id": {"type": "string"}, "version": {"type": "string"}}},
    "resolved_versions": {"type": "object", "minProperties": 1},
    "trial_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["case_id", "trial_id", "outcome", "failure_class", "evidence"],
        "properties": {
          "case_id": {"type": "string"},
          "trial_id": {"type": "string"},
          "outcome": {"enum": ["passed", "failed", "blocked", "indeterminate"]},
          "failure_class": {"enum": ["none", "subject", "evaluator", "infrastructure", "invalid_test", "policy_denial", "indeterminate"]},
          "evidence": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "critical_invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "passed"],
        "properties": {
          "id": {"type": "string"},
          "passed": {"type": "boolean"}
        }
      }
    },
    "metrics": {"type": "object"},
    "verdict": {"enum": ["passed", "failed", "blocked", "indeterminate"]},
    "recommendation": {"enum": ["recommend_release", "recommend_conditional_release", "reject_release", "indeterminate"]},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"}
  }
}
