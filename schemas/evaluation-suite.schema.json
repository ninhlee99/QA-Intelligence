{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qa-intelligence.local/schemas/evaluation-suite.schema.json",
  "title": "Evaluation Suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "status", "owner", "purpose", "subject_type", "traceability", "case_refs", "coverage_dimensions", "gates", "dataset_policy"],
  "properties": {
    "id": {"type": "string"},
    "version": {"type": "string"},
    "status": {"enum": ["draft", "in_review", "accepted", "deprecated", "retired", "rejected"]},
    "owner": {"type": "string"},
    "purpose": {"type": "string"},
    "subject_type": {"enum": ["agent", "skill"]},
    "traceability": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "case_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "coverage_dimensions": {"type": "array", "minItems": 1, "items": {"enum": ["task_success", "trigger", "contract", "policy", "grounding", "tool_use", "efficiency", "robustness", "recovery", "security", "workspace_isolation"]}},
    "minimum_trials": {"type": "integer", "minimum": 1},
    "gates": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["metric", "operator", "threshold", "critical"], "properties": {"metric": {"type": "string"}, "operator": {"enum": ["eq", "gte", "lte"]}, "threshold": {"oneOf": [{"type": "number"}, {"type": "boolean"}, {"type": "string"}]}, "critical": {"type": "boolean"}}}},
    "dataset_policy": {"type": "object", "required": ["classification", "holdout", "contamination_action"], "properties": {"classification": {"enum": ["synthetic", "production_derived", "confidential", "adversarial"]}, "holdout": {"type": "boolean"}, "contamination_action": {"const": "invalidate_comparison"}}}
  }
}
