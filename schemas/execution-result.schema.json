{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qa-intelligence.local/schemas/execution-result.schema.json",
  "title": "Execution Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["execution_id", "attempt_id", "workspace_id", "status", "outcome", "asset_versions", "environment", "started_at", "completed_at", "evidence"],
  "properties": {
    "execution_id": {"type": "string"},
    "attempt_id": {"type": "string"},
    "workspace_id": {"type": "string"},
    "status": {"enum": ["completed", "failed", "cancelled", "timed_out", "blocked"]},
    "outcome": {"enum": ["passed", "failed", "blocked", "skipped", "cancelled", "infrastructure_error", "indeterminate"]},
    "asset_versions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "environment": {"type": "string"},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "infrastructure_status": {"type": "string"}
  }
}
