{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qa-intelligence.local/schemas/workflow.schema.json",
  "title": "Workflow",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "name", "state", "trigger", "preconditions", "actors", "activities", "decisions", "data_consumed", "data_produced", "transitions", "alternate_paths", "failure_paths", "outcome", "evidence", "traces_to"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "state": {"enum": ["current", "target"]},
    "trigger": {"type": "string", "minLength": 1},
    "preconditions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "actors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["actor", "permissions"],
        "properties": {
          "actor": {"type": "string", "minLength": 1},
          "permissions": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "activities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step", "description"],
        "properties": {
          "step": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1}
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description"],
        "properties": {
          "description": {"type": "string", "minLength": 1},
          "rule_ref": {"type": "string", "minLength": 1},
          "open_question": {"type": "string", "minLength": 1}
        }
      }
    },
    "data_consumed": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "data_produced": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from_state", "to_state", "trigger"],
        "properties": {
          "from_state": {"type": "string", "minLength": 1},
          "to_state": {"type": "string", "minLength": 1},
          "trigger": {"type": "string", "minLength": 1}
        }
      }
    },
    "alternate_paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "failure_paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "outcome": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_change", "affected_owner", "assumptions", "validation"],
      "properties": {
        "required_change": {"type": "string", "minLength": 1},
        "affected_owner": {"type": "string", "minLength": 1},
        "assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "validation": {"type": "string", "minLength": 1}
      }
    },
    "traces_to": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
