{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qa-intelligence.local/schemas/agent-run-result.schema.json",
  "title": "Agent Run Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "workspace_id", "outcome", "output", "failure_class", "resolved_versions", "rule_results", "skill_usage", "tool_usage", "citations", "uncertainty", "policy_events", "usage", "evidence", "cleanup_status", "knowledge_candidates", "started_at", "completed_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "minLength": 1},
    "workspace_id": {"type": "string", "minLength": 1},
    "outcome": {"enum": ["completed", "failed", "cancelled", "timed_out", "blocked", "indeterminate"]},
    "output": {"type": ["object", "null"]},
    "failure_class": {"enum": ["subject", "policy", "provider", "skill", "tool", "infrastructure", "evaluator", "orchestration", null]},
    "resolved_versions": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/exactVersionPin"}},
    "rule_results": {"type": "array", "items": {"type": "string"}},
    "skill_usage": {"type": "array", "items": {"type": "string"}},
    "tool_usage": {"type": "array", "items": {"type": "string"}},
    "citations": {"type": "array", "items": {"type": "string"}},
    "uncertainty": {"type": "object", "additionalProperties": false, "required": ["level", "reasons"], "properties": {"level": {"enum": ["none", "low", "medium", "high"]}, "reasons": {"type": "array", "items": {"type": "string"}}}},
    "policy_events": {"type": "array", "items": {"type": "string"}},
    "usage": {"type": "object", "additionalProperties": false, "required": ["steps", "duration_seconds", "tool_calls", "retries"], "properties": {"steps": {"type": "integer", "minimum": 0}, "duration_seconds": {"type": "number", "minimum": 0}, "tool_calls": {"type": "integer", "minimum": 0}, "retries": {"type": "integer", "minimum": 0}, "tokens": {"type": "integer", "minimum": 0}, "cost": {"type": "number", "minimum": 0}, "tool_cost": {"type": "number", "minimum": 0}, "repeated_action_fingerprints": {"type": "integer", "minimum": 0}, "no_progress_iterations": {"type": "integer", "minimum": 0}}},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "cleanup_status": {"enum": ["not_required", "completed", "failed", "incomplete"]},
    "knowledge_candidates": {"type": "array", "items": {"type": "string"}},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"outcome": {"const": "completed"}}, "required": ["outcome"]},
      "then": {"properties": {"failure_class": {"type": "null"}}}
    },
    {
      "if": {"properties": {"outcome": {"enum": ["failed", "blocked", "cancelled", "timed_out"]}}, "required": ["outcome"]},
      "then": {"properties": {"failure_class": {"enum": ["subject", "policy", "provider", "skill", "tool", "infrastructure", "evaluator", "orchestration"]}}}
    }
  ],
  "$defs": {
    "exactVersionPin": {"type": "string", "pattern": "^(?:[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?|[A-Za-z0-9][A-Za-z0-9._:/-]*@[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?)$"}
  }
}
