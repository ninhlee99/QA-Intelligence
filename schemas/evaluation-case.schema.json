{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qa-intelligence.local/schemas/evaluation-case.schema.json",
  "title": "Evaluation Case",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "traceability", "mode", "input", "environment", "budgets", "oracle", "assertions", "cleanup"],
  "properties": {
    "id": {"type": "string"},
    "version": {"type": "string"},
    "traceability": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "mode": {"enum": ["static", "deterministic", "simulation", "replay", "sandbox", "approved_live"]},
    "input": {"type": "object"},
    "environment": {"type": "string"},
    "fixtures": {"type": "array", "items": {"type": "string"}},
    "budgets": {"type": "object", "required": ["max_steps", "max_seconds", "max_tool_calls"], "properties": {"max_steps": {"type": "integer", "minimum": 1}, "max_seconds": {"type": "integer", "minimum": 1}, "max_tool_calls": {"type": "integer", "minimum": 0}}},
    "oracle": {"type": "object", "additionalProperties": false, "required": ["type", "reference"], "properties": {"type": {"enum": ["schema", "rule", "assertion", "rubric", "human"]}, "reference": {"type": "string"}, "judge_ref": {"type": "string"}}},
    "assertions": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "condition", "critical"], "properties": {"id": {"type": "string"}, "condition": {"type": "string"}, "critical": {"type": "boolean"}}}},
    "minimum_trials": {"type": "integer", "minimum": 1},
    "cleanup": {"type": "object", "required": ["required", "verification"], "properties": {"required": {"type": "boolean"}, "verification": {"type": "string"}}}
  }
}
