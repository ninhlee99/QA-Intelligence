{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qa-intelligence.local/schemas/agent-definition.schema.json",
  "title": "Agent Definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "status", "owner", "role", "goals", "non_goals", "workspace_scope", "consequence_class", "skills", "tools", "input_schema", "output_schema", "evidence_requirements", "limits", "escalation", "evaluation_suites"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["draft", "in_review", "accepted", "deprecated", "retired", "rejected"]},
    "owner": {"type": "string", "minLength": 1},
    "role": {"type": "string", "minLength": 1},
    "goals": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "non_goals": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "workspace_scope": {"enum": ["workspace", "global_read_only"]},
    "consequence_class": {"enum": ["advisory", "reversible", "controlled_side_effect", "high_consequence"]},
    "knowledge_scopes": {"type": "array", "items": {"type": "string"}},
    "rule_sets": {"type": "array", "items": {"type": "string"}},
    "skills": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/versionedDependency"}},
    "tools": {"type": "array", "items": {"$ref": "#/$defs/toolPermission"}},
    "prompt_template": {"$ref": "#/$defs/versionedDependency"},
    "input_schema": {"type": "string"},
    "output_schema": {"type": "string"},
    "evidence_requirements": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "limits": {"$ref": "#/$defs/limits"},
    "escalation": {"type": "object", "additionalProperties": false, "required": ["conditions", "owner"], "properties": {"conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "owner": {"type": "string"}}},
    "evaluation_suites": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/versionedDependency"}}
  },
  "$defs": {
    "versionedDependency": {"type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": {"id": {"type": "string"}, "version": {"type": "string"}, "required": {"type": "boolean"}}},
    "toolPermission": {"type": "object", "additionalProperties": false, "required": ["id", "version", "permissions"], "properties": {"id": {"type": "string"}, "version": {"type": "string"}, "permissions": {"type": "array", "items": {"type": "string"}}, "approval_required": {"type": "boolean"}}},
    "limits": {"type": "object", "additionalProperties": false, "required": ["max_steps", "max_duration_seconds", "max_tool_calls", "max_retries"], "properties": {"max_steps": {"type": "integer", "minimum": 1}, "max_duration_seconds": {"type": "integer", "minimum": 1}, "max_tool_calls": {"type": "integer", "minimum": 0}, "max_retries": {"type": "integer", "minimum": 0}, "max_tokens": {"type": "integer", "minimum": 0}, "max_cost": {"type": "number", "minimum": 0}}}
  }
}
