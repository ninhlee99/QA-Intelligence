{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qa-intelligence.local/schemas/business-rule.schema.json",
  "title": "Business Rule",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "status", "title", "authority", "owner", "workspace_scope", "inputs", "applies_when", "decision", "outputs", "priority", "tests"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["draft", "in_review", "accepted", "deprecated", "superseded", "archived"]},
    "title": {"type": "string"},
    "authority": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "owner": {"type": "string"},
    "workspace_scope": {"type": "string"},
    "inputs": {"type": "array", "items": {"type": "object"}},
    "applies_when": {"type": "object"},
    "decision": {"type": "object"},
    "outputs": {"type": "array", "items": {"type": "object"}},
    "priority": {"type": "integer"},
    "tests": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
