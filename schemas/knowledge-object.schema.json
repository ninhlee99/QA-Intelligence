{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qa-intelligence.local/schemas/knowledge-object.schema.json",
  "title": "Knowledge Object",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "version", "status", "workspace_id", "title", "claims", "provenance", "authority", "confidence", "owner", "applicability", "relationships"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "type": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["draft", "in_review", "accepted", "deprecated", "superseded", "archived"]},
    "workspace_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string"},
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "statement", "sources"],
        "properties": {
          "id": {"type": "string"},
          "statement": {"type": "string"},
          "sources": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "provenance": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "authority": {"type": "string", "minLength": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "owner": {"type": "string", "minLength": 1},
    "applicability": {"type": "object"},
    "relationships": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["type", "target_id"], "properties": {"type": {"type": "string"}, "target_id": {"type": "string"}}}},
    "valid_from": {"type": "string", "format": "date-time"},
    "valid_until": {"oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]}
  }
}
