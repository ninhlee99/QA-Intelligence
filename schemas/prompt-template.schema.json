{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qa-intelligence.local/schemas/prompt-template.schema.json",
  "title": "Prompt Template",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "status", "owner", "purpose", "variables", "content", "output_schema", "safety_constraints"],
  "properties": {
    "id": {"type": "string"},
    "version": {"type": "string"},
    "status": {"enum": ["draft", "in_review", "accepted", "deprecated", "retired", "rejected"]},
    "owner": {"type": "string"},
    "purpose": {"type": "string"},
    "variables": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "source", "required"], "properties": {"name": {"type": "string"}, "source": {"enum": ["validated_input", "knowledge_reference", "rule_result", "tool_result", "runtime"]}, "required": {"type": "boolean"}}}},
    "content": {"type": "string", "minLength": 1},
    "output_schema": {"type": "string"},
    "safety_constraints": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
