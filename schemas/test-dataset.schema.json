{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qa-intelligence.local/schemas/test-dataset.schema.json",
  "title": "Test Dataset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "version", "status", "owner", "purpose", "traced_test_refs", "schema_ref", "source",
    "generation_method", "classification", "workspace_scope", "environment_scope", "setup", "teardown",
    "retention", "disposal"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "in_review", "accepted", "deprecated", "retired"]},
    "owner": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "traced_test_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "schema_ref": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "generation_method": {"type": "string", "minLength": 1},
    "classification": {
      "enum": [
        "synthetic",
        "generated_from_template",
        "masked_production_derived",
        "reference",
        "seeded_environment",
        "ephemeral_execution",
        "adversarial_and_boundary",
        "ai_evaluation_dataset"
      ]
    },
    "workspace_scope": {"type": "string", "minLength": 1},
    "environment_scope": {"type": "string", "minLength": 1},
    "validity_constraints": {"type": "array", "items": {"type": "string"}},
    "setup": {"type": "string", "minLength": 1},
    "teardown": {"type": "string", "minLength": 1},
    "retention": {"type": "string", "minLength": 1},
    "disposal": {"type": "string", "minLength": 1},
    "contains_sensitive_fields": {"type": "boolean"},
    "sensitive_field_controls": {"type": "array", "items": {"type": "string"}},
    "ai_evaluation_metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "labels": {"type": "array", "items": {"type": "string"}},
        "representativeness": {"type": "string"},
        "known_bias": {"type": "string"},
        "contamination_risk": {"type": "string"},
        "protected_data_authorization_ref": {"type": "string"}
      }
    }
  }
}
