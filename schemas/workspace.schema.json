{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qa-intelligence.local/schemas/workspace.schema.json",
  "title": "Workspace",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "status", "owner", "policy_version", "created_at"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "status": {"enum": ["provisioning", "active", "suspended", "retiring", "archived"]},
    "owner": {"type": "string"},
    "policy_version": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "classification": {"type": "string"},
    "retention_policy": {"type": "string"}
  }
}
