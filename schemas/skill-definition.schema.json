{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qa-intelligence.local/schemas/skill-definition.schema.json",
  "title": "Skill Definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "status", "owner", "purpose", "non_goals", "positive_triggers", "negative_triggers", "input_schema", "output_schema", "preconditions", "procedure", "postconditions", "evidence_requirements", "side_effect_class", "failure_behavior", "evaluation_suites"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["draft", "in_review", "accepted", "deprecated", "retired", "rejected"]},
    "owner": {"type": "string"},
    "purpose": {"type": "string", "minLength": 1},
    "non_goals": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "positive_triggers": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "negative_triggers": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "input_schema": {"type": "string"},
    "output_schema": {"type": "string"},
    "preconditions": {"type": "array", "items": {"type": "string"}},
    "procedure": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "instruction"],
        "properties": {
          "id": {"type": "string"},
          "instruction": {"type": "string"},
          "decision_rule": {"type": "string"},
          "evidence": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "postconditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "knowledge_scopes": {"type": "array", "items": {"type": "string"}},
    "rule_sets": {"type": "array", "items": {"type": "string"}},
    "tools": {"type": "array", "items": {"type": "string"}},
    "evidence_requirements": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "side_effect_class": {"enum": ["none", "read_only", "reversible", "irreversible"]},
    "idempotency": {"enum": ["not_applicable", "required", "best_effort"]},
    "failure_behavior": {"type": "object", "required": ["on_uncertainty", "on_failure"], "properties": {"on_uncertainty": {"enum": ["fail", "escalate", "request_input"]}, "on_failure": {"enum": ["fail", "compensate", "escalate"]}}},
    "evaluation_suites": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
