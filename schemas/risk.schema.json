{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qa-intelligence.local/schemas/risk.schema.json",
  "title": "Risk",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "status", "statement", "category", "affected", "likelihood_rationale", "impact_rationale", "evidence", "owner", "controls", "residual_risk"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "in_review", "accepted", "monitoring", "closed", "superseded"]},
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cause", "event", "consequence"],
      "properties": {
        "cause": {"type": "string", "minLength": 1},
        "event": {"type": "string", "minLength": 1},
        "consequence": {"type": "string", "minLength": 1}
      }
    },
    "category": {
      "enum": [
        "product_and_business",
        "functional_quality",
        "security_and_privacy",
        "workspace_isolation",
        "data_integrity",
        "ai_and_model_behavior",
        "compatibility_and_migration",
        "performance_and_resilience",
        "operability",
        "compliance"
      ]
    },
    "affected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace_id"],
      "properties": {
        "capability_id": {"type": "string"},
        "requirement_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "workspace_id": {"type": "string", "minLength": 1},
        "consumer_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "likelihood_rationale": {"type": "string", "minLength": 1},
    "impact_rationale": {"type": "string", "minLength": 1},
    "detectability": {"type": "string"},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "owner": {"type": "string", "minLength": 1},
    "controls": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "residual_risk": {"type": "string", "minLength": 1},
    "treatment": {"enum": ["avoid", "reduce", "transfer", "accept", "monitor"]}
  }
}
