{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qa-intelligence.local/schemas/automation-asset.schema.json",
  "title": "Automation Asset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "version", "status", "implemented_test_case_refs", "execution_interface",
    "compatible_engine_refs", "environment_constraints", "owner"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "in_review", "accepted", "deprecated", "retired"]},
    "implemented_test_case_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "execution_interface": {"type": "string", "minLength": 1},
    "compatible_engine_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "compatible_plugin_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "data_requirements": {"type": "array", "items": {"type": "string"}},
    "environment_constraints": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "owner": {"type": "string", "minLength": 1},
    "evidence_mapping": {"type": "array", "items": {"type": "string"}},
    "assertion_map": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expected_result_ref", "assertion_implementation"],
        "properties": {
          "expected_result_ref": {"type": "string", "minLength": 1},
          "assertion_implementation": {"type": "string", "minLength": 1}
        }
      }
    },
    "retry_policy": {"type": "string"}
  }
}
