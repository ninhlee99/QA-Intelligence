{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qa-intelligence.local/schemas/test-strategy.schema.json",
  "title": "Test Strategy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "version", "status", "scope", "objectives", "governing_requirement_refs", "governing_risk_refs",
    "quality_characteristics", "test_levels", "techniques", "environments", "test_data_approach",
    "automation_approach", "entry_criteria", "exit_criteria", "evidence_and_reporting", "owner"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "in_review", "accepted", "deprecated", "superseded"]},
    "scope": {"type": "string", "minLength": 1},
    "objectives": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "governing_requirement_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "governing_risk_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "quality_characteristics": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "test_levels": {
      "type": "array",
      "minItems": 1,
      "items": {"enum": ["unit", "component", "contract", "integration", "system", "end_to_end", "acceptance", "production_verification"]}
    },
    "techniques": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "coverage_model": {"type": "string"},
    "environments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "representativeness"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "representativeness": {"type": "string", "minLength": 1},
          "controlled_differences": {"type": "array", "items": {"type": "string"}},
          "reset_and_recovery": {"type": "string"}
        }
      }
    },
    "test_data_approach": {"type": "string", "minLength": 1},
    "automation_approach": {"type": "string", "minLength": 1},
    "entry_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "exit_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "evidence_and_reporting": {"type": "string", "minLength": 1},
    "roles_and_escalation": {"type": "string"},
    "exclusions": {"type": "array", "items": {"type": "string"}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "residual_risk": {"type": "string"},
    "owner": {"type": "string", "minLength": 1}
  }
}
