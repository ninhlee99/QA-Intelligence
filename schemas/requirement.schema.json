{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qa-intelligence.local/schemas/requirement.schema.json",
  "title": "Requirement",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "status", "title", "statement", "source", "owner", "capability_id", "scope", "acceptance_criteria", "traceability"],
  "properties": {
    "id": {"type": "string"},
    "version": {"type": "string"},
    "status": {"enum": ["draft", "in_review", "accepted", "implemented", "verified", "deprecated", "superseded"]},
    "title": {"type": "string"},
    "statement": {"type": "string", "minLength": 1},
    "source": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "owner": {"type": "string"},
    "capability_id": {"type": "string"},
    "scope": {"type": "object"},
    "rationale": {"type": "string"},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "traceability": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["relationship", "target_id"], "properties": {"relationship": {"type": "string"}, "target_id": {"type": "string"}}}}
  }
}
