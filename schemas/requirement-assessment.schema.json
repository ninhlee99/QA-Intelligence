{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qa-intelligence.local/schemas/requirement-assessment.schema.json",
  "title": "Requirement Quality Assessment",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "requirement_ref", "workspace_id", "outcome", "findings", "questions", "rule_results", "evidence", "uncertainty", "resolved_versions"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "requirement_ref": {"type": "string", "minLength": 1},
    "workspace_id": {"type": "string", "minLength": 1},
    "outcome": {"enum": ["completed", "indeterminate", "blocked"]},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "severity", "message", "evidence"],
        "properties": {
          "id": {"type": "string"},
          "category": {"enum": ["ambiguity", "testability", "completeness", "consistency", "risk", "missing_acceptance_criterion"]},
          "severity": {"enum": ["critical", "high", "medium", "low"]},
          "message": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "questions": {"type": "array", "items": {"type": "string"}},
    "rule_results": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "uncertainty": {"type": "object", "additionalProperties": false, "required": ["level", "reasons"], "properties": {"level": {"enum": ["none", "low", "medium", "high"]}, "reasons": {"type": "array", "items": {"type": "string"}}}},
    "resolved_versions": {"type": "object", "minProperties": 1}
  }
}
