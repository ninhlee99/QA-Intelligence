{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qa-intelligence.local/schemas/knowledge-search-input.schema.json",
  "title": "Knowledge Search Input",
  "type": "object",
  "additionalProperties": false,
  "required": ["query", "limit", "knowledge_snapshot"],
  "properties": {
    "query": {"type": "string", "minLength": 1, "maxLength": 1000},
    "limit": {"type": "integer", "minimum": 1, "maximum": 100},
    "knowledge_snapshot": {"type": "string", "minLength": 1},
    "types": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  }
}
