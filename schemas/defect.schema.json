{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qa-intelligence.local/schemas/defect.schema.json",
  "title": "Defect",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "version", "status", "summary", "observed_behavior", "expected_behavior", "expected_behavior_authority",
    "workspace_scope", "environment_ref", "reproduction_conditions", "evidence", "severity", "severity_rationale",
    "priority", "classification", "owner"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "triaged", "confirmed", "in_progress", "fixed", "verified", "closed", "wont_fix", "duplicate"]},
    "summary": {"type": "string", "minLength": 1},
    "observed_behavior": {"type": "string", "minLength": 1},
    "expected_behavior": {"type": "string", "minLength": 1},
    "expected_behavior_authority": {"type": "string", "minLength": 1},
    "affected_capability_id": {"type": "string"},
    "affected_requirement_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "workspace_scope": {"type": "string", "minLength": 1},
    "environment_ref": {"type": "string", "minLength": 1},
    "artifact_version_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "reproduction_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "severity": {"enum": ["critical", "high", "medium", "low"]},
    "severity_rationale": {"type": "string", "minLength": 1},
    "priority": {"enum": ["p0", "p1", "p2", "p3"]},
    "classification": {
      "enum": [
        "product_defect",
        "requirement_or_rule_defect",
        "test_design_defect",
        "automation_defect",
        "test_data_defect",
        "environment_or_infrastructure_defect",
        "configuration_defect",
        "security_incident",
        "expected_behavior_or_duplicate",
        "unresolved_indeterminate"
      ]
    },
    "suspected_cause": {"type": "string"},
    "confirmed_cause": {"type": "string"},
    "owner": {"type": "string", "minLength": 1},
    "related_execution_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "related_risk_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "related_test_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "fix_evidence": {"type": "array", "items": {"type": "string"}},
    "regression_validation_ref": {"type": "string"},
    "release_ref": {"type": "string"}
  }
}
