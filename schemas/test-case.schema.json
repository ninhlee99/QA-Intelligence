{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qa-intelligence.local/schemas/test-case.schema.json",
  "title": "Test Case",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "status", "purpose", "traceability", "preconditions", "workspace_scope", "steps", "expected_results", "owner"],
  "properties": {
    "id": {"type": "string"},
    "version": {"type": "string"},
    "status": {"enum": ["draft", "in_review", "accepted", "deprecated", "archived"]},
    "purpose": {"type": "string"},
    "traceability": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "preconditions": {"type": "array", "items": {"type": "string"}},
    "workspace_scope": {"type": "string"},
    "data_requirements": {"type": "array", "items": {"type": "string"}},
    "steps": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["action"], "properties": {"action": {"type": "string"}, "input": {"type": "object"}}}},
    "expected_results": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["assertion", "authority"], "properties": {"assertion": {"type": "string"}, "authority": {"type": "string"}}}},
    "owner": {"type": "string"}
  }
}
